# ─── Telegram Bot ────────────────────────────────────────────
BOT_TOKEN=1234567890:AAF...               # BotFather dan olingan token
RAILWAY_PUBLIC_DOMAIN=your-app.railway.app # Railway avtomatik beradi

# ─── App URL (GitHub Pages) ──────────────────────────────────
APP_URL=https://nematovbegz0d.github.io/studentsTools/EduBot.html

# ─── Security ────────────────────────────────────────────────
SECRET_WEBHOOK_TOKEN=random_secret_string  # openssl rand -hex 32

# ─── Admin ───────────────────────────────────────────────────
ADMIN_IDS=123456789                        # Telegram user_id lar, vergul bilan

# ─── Database ────────────────────────────────────────────────
DB_PATH=edubot.db                          # SQLite fayl yo'li

# ─── Payme (paycom.uz) ───────────────────────────────────────
PAYME_MERCHANT_ID=your_merchant_id         # Payme merchant kabinet
PAYME_SECRET_KEY=your_production_key       # Production key
PAYME_TEST_KEY=your_test_key               # Test key (sandbox)
PAYME_TEST=true                            # false = production

# ─── Railway basic-tier (past RAM) sozlamalari ───────────────
# Bu qiymatlar 512MB–1GB instansiyada xotira portlashini oldini oladi.
ML_WORKERS=1                               # bgremove/OCR parallel ishchilar (1 = xavfsiz)
IO_WORKERS=                                # PDF/konversiya ishchilari (bo'sh = avto: CPU soni, max 4)
REMBG_PRELOAD=                             # 1 = startupda AI modelni yuklash (faqat katta instansiyada)
MAX_IMAGE_MPX=40                           # rasm uchun maksimal megapiksel (decompression-bomb himoyasi)
BGREMOVE_MAX_DIM=2000                      # fon olib tashlashda rasmni kichiklashtirish chegarasi (px)
ARGOS_TRANSLATE=                           # 1 = offline argostranslate (og'ir, ixtiyoriy)
# REMBG_MODEL=isnet-general-use            # fon modeli (default: isnet-general-use)
