# EduBot Backend — Environment Variables
# Copy to .env locally, or set in Railway dashboard.
# All variables are OPTIONAL unless marked REQUIRED.

# ─── Telegram Bot (REQUIRED for /webhook + /api/send-file) ────────────────────
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional — Telegram WebApp URL (Mini App link from BotFather)
APP_URL=https://nematovbegz0d.github.io/studentsTools/EduBot.html

# Optional — Telegram secret token for webhook signature verification
# (set via setWebhook secret_token parameter)
WEBHOOK_SECRET=random-shared-secret-here

# ─── Database (PostgreSQL for prod, SQLite for local) ─────────────────────────
# Railway auto-injects DATABASE_URL when Postgres plugin attached.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Local SQLite fallback path (used when DATABASE_URL is empty)
DB_PATH=edubot.db

# ─── Cache (optional Redis; falls back to in-memory) ──────────────────────────
REDIS_URL=redis://default:password@host:6379

# ─── Admin Panel (REQUIRED to access /admin endpoints) ────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=long-random-secret-token

# ─── CORS (comma-separated origins) ───────────────────────────────────────────
# Default: GitHub Pages + Railway domain. Override for custom frontends.
CORS_ORIGINS=https://nematovbegz0d.github.io,https://your-frontend.example

# ─── Backend self-URL (used in cert verification QR codes) ────────────────────
BACKEND_URL=https://studentstools-backend.up.railway.app

# ─── Payme (Uzbekistan payment gateway) — optional, premium feature ──────────
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_KEY=
PAYME_TEST=true

# ─── AI (Anthropic Claude) — optional, /api/summarize uses it ────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxx

# ─── Monitoring (Sentry) — optional ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACE_RATE=0.1

# ─── Service tunables ─────────────────────────────────────────────────────────
# How many PDF pages marker-pdf is allowed to process (heavy ML, slow on big docs)
MARKER_MAX_PAGES=10

# rembg background-removal model (alternatives: u2net, isnet-general-use, birefnet-general)
REMBG_MODEL=birefnet-general

# ─── Heavy feature toggles — set to "1" to disable when memory-constrained ───
MARKER_DISABLED=
DOCLING_DISABLED=
PADDLEOCR_DISABLED=
MEDIAPIPE_DISABLED=
